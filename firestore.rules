rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================

    /** Check if user is signed in (authenticated) */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Check if user is a member of the given tenant by looking up the tenant document's members array.
     *  This replaces the previous custom-claim check (request.auth.token.tenantId) which was never
     *  set for regular (non-SSO) users, causing all tenant-scoped reads to fail with permission-denied.
     *  The Firestore get() is evaluated per-rule and cached within the same request. */
    function isTenantMember(tenantId) {
      return isSignedIn()
        && tenantId != null
        && tenantId != ''
        && request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.members;
    }

    // ========================================================================
    // USERS — global, not tenant-scoped
    // ========================================================================

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ========================================================================
    // TENANTS
    // ========================================================================

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && isTenantMember(tenantId);
      allow update: if isSignedIn() && isTenantMember(tenantId);
      allow delete: if isSignedIn() && isTenantMember(tenantId);

      // Tenant subcollection: agendaWeekData
      match /agendaWeekData/{weekId} {
        allow read: if isSignedIn() && isTenantMember(tenantId);
        allow create: if isSignedIn() && isTenantMember(tenantId);
        allow update: if isSignedIn() && isTenantMember(tenantId);
        allow delete: if isSignedIn() && isTenantMember(tenantId);
      }

      // Tenant subcollection: collab_documents (Admin SDK only for writes)
      match /collab_documents/{docId} {
        allow read: if isSignedIn() && isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant subcollection: collab_presence (Admin SDK only for writes)
      match /collab_presence/{presenceId} {
        allow read: if isSignedIn() && isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant subcollection: collab_comments (Admin SDK only for writes)
      match /collab_comments/{commentId} {
        allow read: if isSignedIn() && isTenantMember(tenantId);
        allow create, update, delete: if false;
      }
    }

    // ========================================================================
    // TOP-LEVEL TENANT-SCOPED COLLECTIONS
    // Pattern: isSignedIn() AND doc.tenantId matches auth token tenantId
    // ========================================================================

    // Projects
    match /projects/{projectId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);

      // Project subcollections — all inherit parent project's tenantId
      match /messages/{messageId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      match /files/{fileId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      match /workPhases/{phaseId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      match /approvals/{approvalId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      match /dailyLogs/{logId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      match /fieldNotes/{noteId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      match /dailyEntries/{entryId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      match /dailyReports/{reportId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      match /weatherCache/{weatherId} {
        allow read: if isSignedIn() && isTenantMember(
          get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow update: if isSignedIn() && isTenantMember(
          get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }

      // Change Order Counter (atomic sequential numbering)
      match /changeOrderCounter/{counterId} {
        allow read: if isSignedIn() && isTenantMember(
          get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
        allow create, update: if isSignedIn() && isTenantMember(
          get(/databases/$(database)/documents/projects/$(projectId)).data.tenantId
        );
      }
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Companies
    match /companies/{companyId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Meetings
    match /meetings/{meetingId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // General Messages (chat)
    match /generalMessages/{messageId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);

      // Reactions subcollection
      match /reactions/{reactionId} {
        allow read: if isSignedIn() && isTenantMember(
          get(/databases/$(database)/documents/generalMessages/$(messageId)).data.tenantId
        );
        allow create: if isSignedIn() && isTenantMember(
          request.resource.data.tenantId != null && request.resource.data.tenantId != ''
            ? request.resource.data.tenantId
            : get(/databases/$(database)/documents/generalMessages/$(messageId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          get(/databases/$(database)/documents/generalMessages/$(messageId)).data.tenantId
        );
      }
    }

    // Gallery Photos
    match /galleryPhotos/{photoId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Inventory Products
    match /invProducts/{productId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Inventory Categories
    match /invCategories/{catId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Inventory Movements
    match /invMovements/{movId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Inventory Transfers
    match /invTransfers/{transId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Time Entries
    match /timeEntries/{entryId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Field Notes (top-level)
    match /fieldNotes/{noteId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Agenda Week Data (top-level — also exists as tenant subcollection)
    match /agendaWeekData/{weekDocId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // RFIs (Request for Information)
    match /rfis/{rfiId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Submittals
    match /submittals/{subId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Punch Items
    match /punchItems/{punchId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Change Orders (Ordenes de Cambio)
    match /changeOrders/{coId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Carnets (Corporate ID Cards)
    match /carnets/{carnetId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Carnet Templates (Visual designer templates)
    match /carnet-templates/{templateId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Catalogs
    match /catalogs/{catalogId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Activity Log
    match /activityLog/{logId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // Kanban Boards (tenant-scoped)
    match /kanbanBoards/{boardId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);

      // Columns subcollection
      match /columns/{columnId} {
        allow read: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/kanbanBoards/$(boardId)).data.tenantId
        );
        allow create: if isSignedIn() && (
          (request.resource.data.tenantId != null && isTenantMember(request.resource.data.tenantId))
          || isTenantMember(get(/databases/$(database)/documents/kanbanBoards/$(boardId)).data.tenantId)
        );
        allow update: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/kanbanBoards/$(boardId)).data.tenantId
        );
        allow delete: if isSignedIn() && isTenantMember(
          resource.data.tenantId != null ? resource.data.tenantId
            : get(/databases/$(database)/documents/kanbanBoards/$(boardId)).data.tenantId
        );
      }
    }

    // Direct Messages — tenant-scoped, accessible by participants
    match /directMessages/{dmId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if false; // Conversations are never hard-deleted

      match /messages/{msgId} {
        allow read: if isSignedIn()
          && isTenantMember(get(/databases/$(database)/documents/directMessages/$(dmId)).data.tenantId);
        allow create: if isSignedIn()
          && isTenantMember(get(/databases/$(database)/documents/directMessages/$(dmId)).data.tenantId);
        allow update: if isSignedIn()
          && isTenantMember(get(/databases/$(database)/documents/directMessages/$(dmId)).data.tenantId);
        allow delete: if isSignedIn()
          && isTenantMember(get(/databases/$(database)/documents/directMessages/$(dmId)).data.tenantId)
          && resource.data.senderId == request.auth.uid; // Only sender can delete their own messages
      }
    }

    // WhatsApp Links (tenant-scoped)
    match /whatsappLinks/{linkId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow delete: if isSignedIn() && isTenantMember(resource.data.tenantId);
    }

    // WhatsApp OTP codes — Admin SDK only
    match /whatsappOtp/{otpId} {
      allow read, write: if false;
    }

    // Integrations — Admin SDK only
    match /integrations/{integrationId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // Integration Logs — Admin SDK only
    match /integration_logs/{logId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // OneDrive files cache — server-managed, client can read
    match /onedrive_files/{fileId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // OneDrive folders cache — server-managed, client can read
    match /onedrive_folders/{folderId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // ========================================================================
    // SYSTEM LOGGING COLLECTIONS
    // ========================================================================

    // Audit Logs — server create only; members can read own tenant
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if false;
      allow update, delete: if false;
    }

    // Error Reports — server create only; members can read own tenant
    match /error_reports/{reportId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if false;
      allow update, delete: if false;
    }

    // Telemetry Events — server only, no client access
    match /telemetry_events/{eventId} {
      allow read, write: if false;
    }

    // Beta Feedback — members can create/read; server manages status
    match /beta_feedback/{feedbackId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if isSignedIn() && isTenantMember(request.resource.data.tenantId);
      allow update: if false;
      allow delete: if false;
    }

    // API Keys — server-managed, users can read their own tenant's keys
    match /apiKeys/{keyId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.tenantId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Document Chunks (RAG) — server-managed, no client access
    match /document_chunks/{chunkId} {
      allow read, write: if false;
    }

  }
}
